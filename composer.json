{
  "name":"ifs24051/stock-app",
  "type":"project",
  "description":"Aplikasi Stock Barang - PABWE P7",
  "keywords":["laravel","livewire","stock","pabwe"],
  "license":"MIT",
  "require":{"php":"^8.3","laravel/framework":"^13.0","livewire/livewire":"^4.0","phpoffice/phpspreadsheet":"^5.0"},
  "require-dev":{"fakerphp/faker":"^1.23","laravel/pail":"^1.2","laravel/pint":"^1.24","mockery/mockery":"^1.6","nunomaduro/collision":"^8.6","phpunit/phpunit":"^12.0"},
  "autoload":{"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
  "scripts":{"test":"php artisan test","test:coverage":"php artisan test --coverage","post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"]},
  "config":{"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true,"allow-plugins":{"php-http/discovery":true}},
  "minimum-stability":"stable","prefer-stable":true
}
